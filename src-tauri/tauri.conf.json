{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hotel-reservation",
  "version": "0.1.4",
  "identifier": "com.dengk.hotel-reservation",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "hotel-reservation",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/automation"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5Nzg4OTdGQzJFQzE3NUUKUldSZUYrekNmNGw0K1FiU1RkMjRoM2lDbVVKcjVYcElwMkNrK1lFaXdtdlZLSDhlZzlGNnFnQTIK",
      "endpoints": [
        "https://github.com/dengkevin456/hotel-reservation/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
